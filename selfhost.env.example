# 旁路容器专用凭证（复制为 .env.selfhost，不要写进 Next 进程）
# 启动：npm run integrations:selfhost
# 巡检：npm run integrations:check-selfhost

# —— Midjourney（midjourney-proxy 容器）——
# Discord 开发者模式复制 User Token；须有自己的 MJ 订阅 + 服务器频道
MJ_DISCORD_USER_TOKEN=
MJ_DISCORD_GUILD_ID=
MJ_DISCORD_CHANNEL_ID=
# 与本站 .env 里 MIDJOURNEY_API_SECRET 保持一致（防别人乱调本地 8080）
MIDJOURNEY_API_SECRET=

# —— Suno（suno-api 容器）——
# 浏览器登录 suno.com/create → F12 → Network → 复制 Cookie 整段
SUNO_COOKIE=
# 2Captcha 余额（Suno 打码）
TWOCAPTCHA_KEY=
