[Unit]
Description=AI supermarket (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai-supermarket/.next/standalone
EnvironmentFile=/home/ubuntu/ai-supermarket/.env
Environment=NODE_ENV=production
Environment=PATH=/opt/nodejs/bin:/usr/bin
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
ExecStart=/opt/nodejs/bin/node server.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
