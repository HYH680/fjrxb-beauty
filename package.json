{
  "name": "ai-supermarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "check:product-en": "node scripts/_check-product-en-coverage.mjs",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "integrations:start": "powershell -ExecutionPolicy Bypass -File scripts/start-integrations.ps1",
    "integrations:fix-docker": "powershell -ExecutionPolicy Bypass -File scripts/fix-wsl-docker.ps1",
    "integrations:stub": "node scripts/n8n-webhook-stub.mjs",
    "integrations:compose:n8n": "docker compose -f docker-compose.integrations.yml --profile n8n up -d",
    "integrations:compose:heavy": "docker compose -f docker-compose.integrations.yml --profile heavy up -d",
    "integrations:compose:full": "docker compose -f docker-compose.integrations.yml --profile full up -d",
    "integrations:compose:selfhost": "docker compose --env-file .env --env-file .env.selfhost -f docker-compose.integrations.yml --profile selfhost up -d",
    "integrations:selfhost": "powershell -ExecutionPolicy Bypass -File scripts/start-selfhost.ps1",
    "integrations:check-selfhost": "powershell -ExecutionPolicy Bypass -File scripts/check-selfhost.ps1",
    "newapi:start": "powershell -ExecutionPolicy Bypass -File scripts/start-newapi.ps1",
    "test:media": "node --env-file=.env scripts/test-dashscope-media.mjs",
    "test:enfirst": "node --experimental-strip-types scripts/test-enfirst-bridge.ts",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File deploy/sync-to-prod.ps1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/react": "^4.0.68",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.65",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ffmpeg-static": "^5.3.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.24.0",
    "motion": "^13.1.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "postprocessing": "^6.39.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.19.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
