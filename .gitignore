# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite
/prisma/dev.db
/prisma/dev.db-journal
/prisma/prod.db
/prisma/prod.db-journal
dev.db
dev.db-journal
prod.db
prod.db-journal

# user-uploaded avatars (keep .gitkeep)
/data/uploads/avatars/*
!/data/uploads/avatars/.gitkeep

# local probe output
/scripts/*.result.json
/scripts/.newapi_*
/scripts/.letta_*
/scripts/CURSOR-REMOTE-SSH.txt
/scripts/windows-ssh.pub
/scripts/*.log
/scripts/second-wifi.pac
**/__pycache__/

# optional portable ffmpeg
/vendor/ffmpeg/*.exe
/vendor/ffmpeg/ffmpeg

# vendor scratch / large clones (not part of site frontend)
/vendor/_tmp_*/
/vendor/capcut-mate/

# local temp / playwright / helper scripts
/tmp-header-test/
/.playwright-cli/
/scripts/_tmp-*
/scripts/_wsl-*

# editor / local agent tooling (keep out of baseline snapshot)
.cursor/
.cursor-dialog-backup/

# workbuddy (not needed in repo)
.workbuddy/

# temp build files
*.tgz
*.log
_tmp-*
.tmp-*
